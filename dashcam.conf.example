# dashcam configuration
# Copy to ~/.dashcam/dashcam.conf (the systemd service runs with that as its
# working directory and reads ./dashcam.conf). Every key is optional; values
# shown are the built-in defaults. Unknown keys and invalid values are
# reported to stderr and ignored.

# Camera backend: pi (libcamera; works with the Pi Camera Module and any
# camera libcamera supports, including UVC webcams).
camera_backend = pi

# Frame orientation correction: "auto" applies the rotation reported by the
# sensor; or force one of "0", "90", "180", "270" and their mirrored forms
# "mirror-0", "mirror-90", "mirror-180", "mirror-270" (horizontal flip, then
# rotation). The value is the clockwise pixel rotation applied to every
# captured frame; it corrects a camera mounted rotated that many degrees
# anti-clockwise. If an explicit value comes out upside down, use 360 minus
# that value. Note "90"/"270" swap the output dimensions: a camera mounted on
# its side necessarily records portrait (720x1280); upright landscape is only
# possible with an upright mounting. Use an explicit value when the physical
# mounting differs from what the sensor reports (the Pi reports a fixed
# per-module value and cannot see how you actually mounted it).
camera_orientation = auto

# Where recordings and manifest.jsonl are written (relative to the working
# directory, or absolute).
video_dir = videos

# Driving trigger (motion-as-driving proxy): recording stops only after this
# many consecutive seconds with no motion. Mid-drive fragmentation at stops
# shorter than this is expected and accepted.
no_motion_timeout_seconds = 120

# Frame capture rate while idle (watching for motion) and while recording.
idle_fps = 5.0
recording_fps = 30.0

# Minimum contour area, in pixels, that a frame difference must exceed to
# count as motion. Resolution-dependent: raise if false triggers, lower if
# motion at night or at distance is missed.
motion_threshold = 10000

# Recording files are closed and rolled over every this many seconds, so a
# power cut loses at most one segment. Closed segments are registered in the
# manifest; an interrupted segment is quarantined on next boot.
segment_length_seconds = 120

# Video encoder: "hw" uses the Pi's hardware H.264 codec (/dev/video11) and
# writes fragmented MP4 (fragments stay playable after a power cut); "sw"
# uses the portable OpenCV software path; "auto" tries hardware first and
# falls back to software.
encoder = auto

# Hardware encoder target bitrate (kbps) and IDR/fragment interval (seconds).
video_bitrate_kbps = 5000
video_gop_seconds = 2

# Storage cleanup: the oldest recordings (per the manifest) are deleted to keep
# at least this many MB free on the video volume. Recording also pauses rather
# than filling the card if it cannot reclaim enough. This value doubles as the
# recorder's free-space pause floor.
min_free_mb = 512

# Additionally delete any recording older than this many days. 0 disables the
# age limit, leaving free space as the only driver (loop recording).
retention_days = 0
